-- Helper to create CreateText with backwards-compatible :Set() handling
local function CreateTextElement(tab, config)
    local title = config.name or config.Name or ""
    local text = config.text or config.Text or ""
    
    local elem = tab:CreateText({
        name = title,
        text = text
    })
    
    local handle = {}
    function handle:Set(newConfig)
        local newText
        if typeof(newConfig) == "table" then
            newText = newConfig.text or newConfig.Text or newConfig.Content or newConfig.content or ""
        else
            newText = tostring(newConfig or "")
        end
        
        -- Rayfield Gen2 element:Set() strictly takes a string
        if elem and typeof(elem.Set) == "function" then
            elem:Set(tostring(newText))
        end
    end
    
    return handle
end

