local function isInventoryFull()
    local inventory = LocalPlayer:FindFirstChild("BackpackTwo")
    if not inventory then return false end
    
    local capacity = LocalPlayer:GetAttribute("InventorySize") or 500
    local count = #inventory:GetChildren()
    
    local character = LocalPlayer.Character
    if character and character:FindFirstChildOfClass("Tool") then
        count = count + 1
    end
    
    return count >= capacity
end

local function sellAll()
    if isSelling then return end
    isSelling = true
    
    local sellRemote = ReplicatedStorage:FindFirstChild("Remotes")
        and ReplicatedStorage.Remotes:FindFirstChild("Shop")
        and ReplicatedStorage.Remotes.Shop:FindFirstChild("SellAll")
        
    if sellRemote then
        pcall(function()
            sellRemote:InvokeServer()
        end)
        Notify("Info", "Inventory full! Sold all items.", 3)
        task.wait(0.5)
    end
    
    isSelling = false
end

local function startSellLoop()
    if sellThread then return end
    sellThread = task.spawn(function()
        while isAutoSell do
            if isInventoryFull() and not isSelling then
                sellAll()
            end
            task.wait(2)
        end
        sellThread = nil
    end)
end

local function stopSellLoop()
    isAutoSell = false
    if sellThread then
        task.cancel(sellThread)
        sellThread = nil
    end
end

------------- /////// AUTO LOCK \\\\\\\ -------------

local function lockItemsLoop()
    if autoLockThread then return end
    autoLockThread = task.spawn(function()
        while isAutoLockEnabled do
            local inventory = LocalPlayer:FindFirstChild("BackpackTwo")
            local lockRemote = ReplicatedStorage:FindFirstChild("Remotes")
                and ReplicatedStorage.Remotes:FindFirstChild("Inventory")
                and ReplicatedStorage.Remotes.Inventory:FindFirstChild("ToggleLock")

            if inventory and lockRemote and lockTargetWeight > 0 and #lockSelectedRarities > 0 then
                for _, item in ipairs(inventory:GetChildren()) do
                    if item:IsA("Tool") then
                        local rarity = item:GetAttribute("Rarity")
                        local itemData = item:FindFirstChild("ItemData")
                        
                        if rarity and itemData then
                            local isSelectedRarity = false
                            for _, selected in ipairs(lockSelectedRarities) do
                                if selected == rarity then
                                    isSelectedRarity = true
                                    break
                                end
                            end

                            if isSelectedRarity then
                                local weight = itemData:GetAttribute("Weight")
                                if weight == lockTargetWeight then
                                    local isLocked = item:GetAttribute("Locked")
                                    if not isLocked then
                                        pcall(function()
                                            lockRemote:FireServer(item)
                                        end)
                                        task.wait(0.1) 
                                    end
                                end
                            end
                        end
                    end
                end
            end
            task.wait(1) 
        end
        autoLockThread = nil
    end)
end

local function stopAutoLock()
    isAutoLockEnabled = false
    if autoLockThread then
        task.cancel(autoLockThread)
        autoLockThread = nil
    end
end

