local DEBUG = false               
local STUCK_DIG_TIMEOUT = 5       
local STUCK_SHAKE_TIMEOUT = 6     
local ARRIVE_DISTANCE = 6         
local MAX_DIG_INFLIGHT = 2        
local SHAKE_SOFT_TIMEOUT = 1      
local PAN_RETRY_INTERVAL = 0.3    

local digInFlight = 0
local shakeCommitted = false   

local function dbg(...)
    if DEBUG then print("[VermzHub AutoFarm]", ...) end
end

local function findPanIn(container)
    if not container then return nil end
    for _, item in ipairs(container:GetChildren()) do
        if item:IsA("Tool") and item.Name:find("Pan") then
            return item
        end
    end
    return nil
end

local function getPanTool()
    return findPanIn(LocalPlayer.Character)
        or findPanIn(LocalPlayer:FindFirstChild("Backpack"))
        or findPanIn(LocalPlayer:FindFirstChild("BackpackTwo"))
end

local function getPanRemotes()
    local character = LocalPlayer.Character
    if not character then return nil end

    local pan = findPanIn(character)
    if not pan then return nil end

    local scripts = pan:FindFirstChild("Scripts")
    if not scripts then return nil end

    return {
        pan = pan,
        collect = scripts:FindFirstChild("Collect"),
        shake = scripts:FindFirstChild("Shake"),
        panRemote = scripts:FindFirstChild("Pan"),
    }
end

local function getPanFillInfo()
    local remotes = getPanRemotes()
    if not remotes or not remotes.pan then return 0, 1 end
    local stats = LocalPlayer:FindFirstChild("Stats")
    local fill = remotes.pan:GetAttribute("Fill") or 0
    local capacity = stats and stats:GetAttribute("Capacity") or 1
    return fill, capacity
end

local function isPanFull()
    local fill, capacity = getPanFillInfo()
    return fill >= capacity
end

local function isPanEmpty()
    local fill = getPanFillInfo()
    return fill <= 0
end

local function hasItems()
    local fill = getPanFillInfo()
    return fill > 0
end

local function equipPan()
    local character = LocalPlayer.Character
    if not character then return false end
    if getPanRemotes() then return true end

    local pan = getPanTool()
    if not pan then return false end

    local equipRemote = ReplicatedStorage:FindFirstChild("Remotes")
        and ReplicatedStorage.Remotes:FindFirstChild("CustomBackpack")
        and ReplicatedStorage.Remotes.CustomBackpack:FindFirstChild("EquipRemote")

    if equipRemote then
        pcall(function() equipRemote:FireServer(pan) end)
    else
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then pcall(function() humanoid:EquipTool(pan) end) end
    end

    local t = 0
    while t < 1 and not getPanRemotes() do
        task.wait(0.1)
        t = t + 0.1
    end
    return getPanRemotes() ~= nil
end

------------- helpers: panning state / movement -------------

local function getHRP()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function flatDistance(a, b)
    return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function isPanning()
    local c = LocalPlayer.Character
    return c ~= nil and c:GetAttribute("Panning") == true
end

local function stopPanning()
    if not isPanning() then return true end

    local remotes = getPanRemotes()
    if remotes and remotes.panRemote then
        task.spawn(function()
            pcall(function() remotes.panRemote:InvokeServer() end)
        end)
    end

    local t = 0
    while isPanning() and t < 1.5 do
        task.wait(0.05)
        t = t + 0.05
    end
    return not isPanning()
end

local function nudge()
    local c = LocalPlayer.Character
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end
    hum.Jump = true
    hum:MoveTo(hrp.Position + Vector3.new(math.random(-3, 3), 0, math.random(-3, 3)))
    task.wait(0.4)
end

local function teleportTo(position)
    local c = LocalPlayer.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false end

    hum:MoveTo(hrp.Position)
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    local lift = 3 
    hrp.CFrame = CFrame.new(position + Vector3.new(0, lift, 0))

    task.wait(0.35)

    local newHrp = getHRP()
    if not newHrp then return false end
    
    local dist = flatDistance(newHrp.Position, position)
    
    if dist > ARRIVE_DISTANCE then
        return false
    end
    
    return true
end

local function walkTo(position)
    local c = LocalPlayer.Character
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    if not hum then return false end

    local baseSpeed = hum:GetAttribute("BaseWalkSpeed") or hum.WalkSpeed or 16
    if isWalkSpeedEnabled then baseSpeed = targetWalkSpeed end
    if baseSpeed < 1 then baseSpeed = 16 end
    hum.WalkSpeed = baseSpeed

    local startTime = os.clock()
    local lastReissue = 0

    while isAutoFarm do
        local hrp = getHRP()
        local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if not hrp or not h then return false end

        if flatDistance(hrp.Position, position) < 4 then
            h:MoveTo(hrp.Position)
            return true
        end

        local now = os.clock()
        if now - lastReissue > 0.2 then
            h:MoveTo(position)
            lastReissue = now
        end

        if now - startTime > 15 then
            h:MoveTo(hrp.Position)
            return false
        end

        task.wait(0.05)
    end
    return false
end

local function goToPosition(position)
    if not isAutoFarm or not position then return false end

    stopPanning() 

    if selectedMethod == "Teleport" then
        if teleportTo(position) then 
            return true 
        end
        
        dbg("Teleport failed or rubberbanded. Retrying...")
        
        if teleportTo(position) then 
            return true 
        end
        
        dbg("Teleport failed twice. Falling back to Walk.")
        return walkTo(position)
    else
        return walkTo(position)
    end
end

local function recover(position)
    dbg("stuck -> recovering")
    digInFlight = 0
    stopPanning()
    if not getPanRemotes() then equipPan() end
    nudge()
    goToPosition(position)
    task.wait(0.15)
end

------------- /////// FARM ACTIONS \\\\\\\ -------------

local function digAtSand()
    local remotes = getPanRemotes()
    if not remotes or not remotes.collect then return false end

    if digInFlight >= MAX_DIG_INFLIGHT then return true end
    digInFlight = digInFlight + 1

    local collect = remotes.collect
    task.spawn(function()
        pcall(function() collect:InvokeServer(1, false) end)
        digInFlight = math.max(0, digInFlight - 1)
    end)
    return true
end

local function firePanRemote()
    local r = getPanRemotes()
    if r and r.panRemote then
        task.spawn(function()
            pcall(function() r.panRemote:InvokeServer() end)
        end)
    end
end

local function shakeBackground(position)
    local lastFill = getPanFillInfo()
    local lastChange = os.clock()
    local lastPanTry = 0
    local wasPanning = false

    while isAutoFarm and hasItems() do
        local remotes = getPanRemotes()
        local now = os.clock()

        local hrp = getHRP()
        if hrp and flatDistance(hrp.Position, position) > 15 then
            break
        end

        local panning = isPanning()

        if not panning and now - lastPanTry > PAN_RETRY_INTERVAL then
            lastPanTry = now
            firePanRemote()
        end

        if remotes and remotes.shake then
            pcall(function() remotes.shake:FireServer() end)
        end

        if panning and now - lastChange > SHAKE_SOFT_TIMEOUT then
            firePanRemote()
            task.wait(0.12)
            firePanRemote()
            task.wait(0.12)
            lastChange = os.clock()
        end

        task.wait()
    end
    stopPanning()
end

local function waterPhase()
    dbg("water phase")
    
    if not goToPosition(waterPosition) then return false end

    task.wait(0.2)

    local shakeThread = task.spawn(function()
        shakeBackground(waterPosition)
    end)

    dbg("Walking to sand while shaking...")
    goToPosition(sandPosition)

    task.wait(0.5)
    while isAutoFarm and hasItems() and coroutine.status(shakeThread) ~= "dead" do
        task.wait(0.1)
    end

    stopPanning()
    return true
end

local function landPhase()
    dbg("land phase")
    
    local hrp = getHRP()
    if hrp and flatDistance(hrp.Position, sandPosition) > 12 then
        if not goToPosition(sandPosition) then return false end
    end

    local lastFill = getPanFillInfo()
    local lastChange = os.clock()

    while isAutoFarm and not isSelling and not isPanFull() do
        if not getPanRemotes() then
            equipPan()
            task.wait(0.2)
            continue
        end

        if isPanning() then stopPanning() end

        local currentHrp = getHRP()
        if currentHrp and flatDistance(currentHrp.Position, sandPosition) > 12 then
            goToPosition(sandPosition)
            lastChange = os.clock()
        end

        digAtSand()

        local fill = getPanFillInfo()
        if fill ~= lastFill then
            lastFill = fill
            lastChange = os.clock()
        end

        if os.clock() - lastChange > STUCK_DIG_TIMEOUT then
            recover(sandPosition)
            lastChange = os.clock()
            lastFill = getPanFillInfo()
        end

        task.wait(0.03)
    end
    return true
end

------------- /////// WATCHDOG + MAIN LOOP \\\\\\\ -------------

local function startEquipWatchdog()
    if equipWatchdog then return end
    equipWatchdog = task.spawn(function()
        while isAutoFarm do
            if not getPanRemotes() then equipPan() end
            task.wait(0.5)
        end
        equipWatchdog = nil
    end)
end

local function stopEquipWatchdog()
    if equipWatchdog then
        task.cancel(equipWatchdog)
        equipWatchdog = nil
    end
end

local function farmStep()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        task.wait(0.5)
        return
    end

    if isSelling then
        task.wait(0.5)
        return
    end

    if not getPanRemotes() then
        if not equipPan() then task.wait(0.5) end
        return
    end

    if isPanFull() then shakeCommitted = true end

    local ok
    if shakeCommitted and hasItems() then
        ok = waterPhase()
    else
        shakeCommitted = false
        ok = landPhase()
    end

    if not ok then task.wait(0.3) end
end

local function startFarmLoop()
    if farmThread then return end

    if not equipPan() then
        Notify("Error", "Failed to equip pan.", 3)
        isAutoFarm = false
        return
    end

    startEquipWatchdog()

    farmThread = task.spawn(function()
        while isAutoFarm do
            local ok, err = pcall(farmStep)
            if not ok then
                warn("[VermzHub AutoFarm] error: " .. tostring(err))
                task.wait(0.5)
            end
            task.wait(0.05)
        end
        farmThread = nil
    end)
end

local function stopFarmLoop()
    isAutoFarm = false
    stopEquipWatchdog()
    if farmThread then
        task.cancel(farmThread)
        farmThread = nil
    end
    digInFlight = 0
    shakeCommitted = false

    local character = LocalPlayer.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if humanoid and hrp then humanoid:MoveTo(hrp.Position) end
    end

    task.spawn(stopPanning)
end

local function formatPosition(pos)
    if not pos then return "Not set" end
    return string.format("X: %.1f, Y: %.1f, Z: %.1f", pos.X, pos.Y, pos.Z)
end

local function getGroundPosition()
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character }
    local result = Workspace:Raycast(hrp.Position + Vector3.new(0, 5, 0), Vector3.new(0, -20, 0), params)
    return result and result.Position or hrp.Position
end

local function savePositions()
    if not writefile then return end
    pcall(function()
        writefile(SAVE_FILE, HttpService:JSONEncode({
            sand = sandPosition and { sandPosition.X, sandPosition.Y, sandPosition.Z } or nil,
            water = waterPosition and { waterPosition.X, waterPosition.Y, waterPosition.Z } or nil,
        }))
    end)
end

local function loadPositions()
    if not (isfile and readfile) then return end
    local ok, data = pcall(function()
        if isfile(SAVE_FILE) then return HttpService:JSONDecode(readfile(SAVE_FILE)) end
    end)
    if ok and type(data) == "table" then
        if type(data.sand) == "table" then sandPosition = Vector3.new(data.sand[1], data.sand[2], data.sand[3]) end
        if type(data.water) == "table" then waterPosition = Vector3.new(data.water[1], data.water[2], data.water[3]) end
    end
end

