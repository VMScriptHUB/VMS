        table.insert(sluiceShopItemNames, displayName)
    end
    table.sort(sluiceShopItemNames, function(a, b)
        return sluiceShopDisplayToModel[a].sortPrice < sluiceShopDisplayToModel[b].sortPrice
    end)
end

refreshSluiceShopList()

Shop:CreateDropdown({
    Name = "Select Sluices to Buy",
    Options = sluiceShopItemNames,
    CurrentOption = {},
    MultipleOptions = false,
    Flag = "shopsluices",
    Callback = function(Options)
        shopSluiceSelectedItems = typeof(Options) == "table" and Options or {Options}
    end,
})

Shop:CreateButton({
    Name = "Buy Selected Sluice",
