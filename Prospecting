local function getItemPrice(shopItem)
    local price = shopItem:GetAttribute("Price")
    if price then return price end
    local shardPrice = shopItem:GetAttribute("ShardPrice")
    if shardPrice then return shardPrice end
    return math.huge 
end

local function getShopItems()
    local purchasable = Workspace:FindFirstChild("Purchasable")
    local items = {}
    
    local formatModule = nil
    pcall(function()
        formatModule = require(ReplicatedStorage.Modules.Utility.FormatNumber)
    end)

    local function formatNum(num)
        if type(num) ~= "number" then num = tonumber(num) or 0 end
        if formatModule and formatModule.FormatWithAbbreviations then
            return formatModule.FormatWithAbbreviations(num)
        end
        return tostring(num) 
    end
    
    if not purchasable then return items end

    for _, folder in ipairs(purchasable:GetChildren()) do
        if folder:IsA("Folder") then
            local folderName = folder.Name
            if folderName == "North Pole" or folderName == "Summer" or folderName == "Halloween" then
                continue
            end

            for _, model in ipairs(folder:GetChildren()) do
                if model:IsA("Model") then
                    local nameLower = string.lower(model.Name)
                    local isPotion = nameLower:find("potion") or nameLower:find("brew") or nameLower:find("ambrosia")
                    
                    if isPotion then
                        local shopItem = model:FindFirstChild("ShopItem")
                        if shopItem then
                            local price = shopItem:GetAttribute("Price")
                            local shardPrice = shopItem:GetAttribute("ShardPrice")
                            
                            local displayName = model.Name
                            if price then
                                displayName = displayName .. " ($" .. formatNum(price) .. ")"
                            elseif shardPrice then
                                displayName = displayName .. " (" .. formatNum(shardPrice) .. " Shards)"
                            end
                            
                            items[displayName] = {
                                model = model,
                                shopItem = shopItem,
                                sortPrice = getItemPrice(shopItem)
                            }
                        end
                    end
                end
            end
        end
    end
    
    return items
end

local function buyItems()
    local buyRemote = ReplicatedStorage:FindFirstChild("Remotes")
        and ReplicatedStorage.Remotes:FindFirstChild("Shop")
        and ReplicatedStorage.Remotes.Shop:FindFirstChild("BuyItem")
        
    if not buyRemote then
        Notify("Error", "BuyItem remote not found!", 3)
        return
    end

    local shopData = getShopItems()
    
    if #shopSelectedItems == 0 then
        Notify("Error", "Please select at least one item to buy!", 3)
        return
    end
    
    if shopBuyAmount <= 0 then
        Notify("Error", "Please enter a valid amount!", 3)
        return
    end

    for _, displayName in ipairs(shopSelectedItems) do
        local itemInfo = shopData[displayName]
        if itemInfo then
            pcall(function()
                buyRemote:InvokeServer(itemInfo.shopItem, shopBuyAmount)
            end)
            task.wait(0.2)
        end
    end
    
    Notify("Success", "Attempted to buy selected items!", 3)
end

