local function createGeodeESP()
    local geodeFolder = Workspace:FindFirstChild("Geode")
    if not geodeFolder then return end

    for _, geode in ipairs(geodeFolder:GetChildren()) do
        local depositName = geode:GetAttribute("Deposit")
        if depositName then
            local nameDrawing = Drawing.new("Text")
            nameDrawing.Text = depositName
            nameDrawing.Color = Color3.fromRGB(255, 215, 0)
            nameDrawing.Size = 16
            nameDrawing.Center = true
            nameDrawing.Outline = true
            nameDrawing.OutlineColor = Color3.new(0, 0, 0)
            nameDrawing.Visible = false
            
            local distDrawing = Drawing.new("Text")
            distDrawing.Text = "0m"
            distDrawing.Color = Color3.fromRGB(255, 255, 255)
            distDrawing.Size = 14
            distDrawing.Center = true
            distDrawing.Outline = true
            distDrawing.OutlineColor = Color3.new(0, 0, 0)
            distDrawing.Visible = false
            
            geodeDrawings[geode] = {
                nameDrawing = nameDrawing,
                distDrawing = distDrawing,
                name = depositName
            }
        end
    end
end

local function clearGeodeESP()
    for _, data in pairs(geodeDrawings) do
        if data.nameDrawing then data.nameDrawing:Remove() end
        if data.distDrawing then data.distDrawing:Remove() end
    end
    geodeDrawings = {}
end

RunService.RenderStepped:Connect(function()
    if not geodeESPActive then return end
    local camera = Workspace.CurrentCamera
    if not camera then return end

    for geode, data in pairs(geodeDrawings) do
        if not geode or not geode.Parent then
            data.nameDrawing.Visible = false
            data.distDrawing.Visible = false
            continue
        end
        
        local primaryPart = geode.PrimaryPart or geode:FindFirstChildWhichIsA("BasePart")
        if primaryPart then
            local pos, onScreen = camera:WorldToViewportPoint(primaryPart.Position)
            if onScreen then
                local dist = (camera.CFrame.Position - primaryPart.Position).Magnitude
                local roundedDist = math.floor(dist)
                
                local scaleFactor = math.clamp(300 / dist, 10, 18)
                
                data.nameDrawing.Size = scaleFactor
                data.nameDrawing.Position = Vector2.new(pos.X, pos.Y)
                data.nameDrawing.Visible = true
                
                data.distDrawing.Text = string.format("%dm", roundedDist)
                data.distDrawing.Size = scaleFactor - 2
                data.distDrawing.Position = Vector2.new(pos.X, pos.Y + scaleFactor + 2)
                data.distDrawing.Visible = true
            else
                data.nameDrawing.Visible = false
                data.distDrawing.Visible = false
            end
        end
    end
end)

Workspace:WaitForChild("Geode").ChildAdded:Connect(function()
    if geodeESPActive then
        clearGeodeESP()
        createGeodeESP()
    end
end)

